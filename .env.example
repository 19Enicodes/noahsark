# Noah's Ark messaging credentials.
# Copy to .env and fill in real values. NEVER commit .env.

# --- SMS (Termii) -----------------------------------------------------------
# Get these from your Termii dashboard. If TERMII_API_KEY is blank,
# SMS sending is skipped and logged as "not configured" - it will not silently fail.
TERMII_API_KEY=
TERMII_SENDER_ID=

# --- Email (Gmail SMTP) -----------------------------------------------------
# EMAIL_HOST_PASSWORD must be a 16-character Google App Password, NOT the
# account password. Enable 2-Step Verification on the account first, then
# generate one at https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=rccgnaycmessages@gmail.com
EMAIL_HOST_PASSWORD=

# Optional: what recipients see in the From field.
DEFAULT_FROM_EMAIL=Noah's Ark <rccgnaycmessages@gmail.com>

# --- Global controls --------------------------------------------------------
# Set to false to stop ALL outbound SMS and email without touching code.
MESSAGING_ENABLED=true

# For local testing without sending real email, uncomment this to print
# messages to the terminal instead:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
